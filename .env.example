# ====================================================================
# Logbook — contoh konfigurasi DEPLOYMENT (Docker production)
# Salin menjadi .env dan sesuaikan.
# ====================================================================
APP_NAME="Logbook"
APP_ENV=production
# WAJIB: generate dengan `php artisan key:generate` lalu isi di sini.
# Docker compose membaca ${APP_KEY} — tanpanya Laravel gagal boot.
APP_KEY=
# Override versi rilis yang tampil di UI (opsional). Kosongkan agar otomatis dari CHANGELOG.
APP_VERSION=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
# URL publik aplikasi (diakses browser). Ganti dengan domain/IP server Anda.
# Contoh: http://192.168.1.10:8280 atau https://logbook.domain.com
APP_URL=http://localhost:8280
# Setel true bila aplikasi diakses lewat reverse-proxy HTTPS (mis. https://domain)
# supaya seluruh URL Laravel memakai https (cegah mixed content yang memblokir viewer PDF).
APP_FORCE_HTTPS=false
# Daftar proxy/ingress IP (CIDR) yang dipercaya untuk header X-Forwarded-* (pisahkan koma).
# Kosongkan (default) = tidak memercayai header forwarded (aman). Contoh: 10.0.0.0/8,192.168.1.0/24
TRUSTED_PROXIES=

# Tautan eksternal (sesuaikan per institusi)
APP_JADWAL_URL=https://<schedule-url>/
# Mode aplikasi: saas (default) — user personal & institusi hidup bersamaan.
# Nilai lain ('individual'/'institution') dipertahankan untuk kompatibilitas
# namun tidak lagi dipakai untuk meng-gate fitur.
APP_MODE=saas
APP_TEMPLATE_URL=https://<template-url>/

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# MySQL 8.4
DB_CONNECTION=mysql
DB_HOST=logbook-ta-db
DB_PORT=3306
DB_DATABASE=logbook_ta
DB_USERNAME=logbook
# Set a unique strong password in the deployment environment.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Session/cache/queue via Redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=predis
REDIS_HOST=logbook-ta-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit (dev)
MAIL_MAILER=smtp
MAIL_HOST=logbook-ta-mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Reverb
# Generate unique Reverb credentials per deployment; do not commit them.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="logbook-ta-reverb"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST="0.0.0.0"
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
